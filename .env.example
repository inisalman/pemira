# PEMIRA environment example — copy to .env and fill in. Never commit .env.

# Private runtime config (server-only). Required.
# Format: postgres://user:password@host:port/database
NUXT_DATABASE_URL=postgres://pemira:change-me@localhost:5432/pemira_dev

# Private runtime config (server-only). Generate with: openssl rand -base64 48
NUXT_SESSION_SECRET=change-me

# Public runtime config (browser-safe). Optional; defaults come from nuxt.config.ts.
NUXT_PUBLIC_APP_NAME=PEMIRA

# Migration/seed tooling (server-only, used by npm run db:migrate / db:seed).
DATABASE_URL=postgres://pemira:change-me@localhost:5432/pemira_dev
